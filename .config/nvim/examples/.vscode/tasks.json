{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compile lldb",
      "type": "shell",
      "command": "clang++ -std=c++20 -glldb -fstandalone-debug ${relativeFile} -o ${workspaceFolder}/${fileBasenameNoExtension}"
    },
    {
      "label": "Compile G++",
      "type": "shell",
      "command": "g++ -ggdb ${relativeFile} -o ${workspaceFolder}/${fileBasenameNoExtension}"
    },
    {
      "label": "Clean",
      "type": "shell",
      "command": "rm ${workspaceFolder}/${fileBasenameNoExtension}"
    },
    {
      "label": "test overseer 00",
      "type": "shell",
      "command": "echo ${input:variableID}"
    }
  ],
  "inputs": [
    {
      "id": "variableID",
      "type": "type of input variable"
    }
  ]
}
